# Salin file ini menjadi ".env" (di folder yang sama), lalu isi nilainya.
# File .env TIDAK ikut ter-upload ke GitHub (sudah diatur di .gitignore).

# ===== Kak Deret (AI DeepSeek), hanya dibaca oleh server Python =====
# Buat key di https://platform.deepseek.com/api_keys (lalu isi saldo / top up)
DEEPSEEK_API_KEY=
# Model: deepseek-flash (murah & cepat) atau deepseek-v4-pro (lebih pintar, lebih mahal)
DEEPSEEK_MODEL=deepseek-flash
# Batas pemakaian agar saldo aman
AI_BATAS_PER_10_MENIT=20
AI_BATAS_HARIAN=1000

# ===== Alamat server Python yang dipakai aplikasi web =====
# Kosongkan untuk memakai http://localhost:8000
VITE_API_URL=

# ===== Supabase (opsional, untuk data online). Biarkan kosong jika tidak dipakai =====
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
