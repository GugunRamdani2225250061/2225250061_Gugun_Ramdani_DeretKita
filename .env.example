# Salin file ini menjadi ".env" (di folder yang sama), lalu isi nilainya.
# File .env TIDAK ikut ter-upload ke GitHub (sudah diatur di .gitignore).

# ===== Kak Deret (AI), hanya dibaca oleh server Python =====
# Pilihan penyedia: openrouter (GRATIS) | deepseek (berbayar) | groq | gemini | ollama (di laptop, tanpa key)
AI_PROVIDER=openrouter
# Key OpenRouter gratis: https://openrouter.ai/keys
AI_API_KEY=
# Kosongkan agar server memilih model gratis terbaik secara otomatis (dan pindah otomatis jika kuota habis)
AI_MODEL=
# Batas pemakaian per perangkat & per hari
AI_BATAS_PER_10_MENIT=20
AI_BATAS_HARIAN=1000

# (Opsional) DeepSeek berbayar: isi key & ubah AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# ===== Alamat server Python yang dipakai aplikasi web =====
# Kosongkan untuk memakai http://localhost:8000
VITE_API_URL=

# ===== Supabase (opsional, untuk data online). Biarkan kosong jika tidak dipakai =====
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
